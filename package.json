{
  "name": "mentorconnect",
  "private": true,
  "scripts": {
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "cv-scoring": "cd services/cv-scoring && npm run dev",
    "dev": "concurrently \"npm run client\" \"npm run server\"",
    "dev:all": "concurrently \"npm run client\" \"npm run server\" \"npm run cv-scoring\"",
    "postinstall": "cd server && npx prisma generate",
    "vercel-build": "cd server && npx prisma generate && cd ../client && npm install && npm run build"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "concurrently": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
